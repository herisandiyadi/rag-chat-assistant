# ─── Secrets ───────────────────────────────────────────────
# NEVER commit real values. Copy to .env and fill locally.
POSTGRES_USER=ragchat
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rag_chat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ─── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Voice: ElevenLabs ─────────────────────────────────────
# IMPORTANT: rotate keys immediately if ever exposed in git history.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=q5aR9u5Hgw9zqew8VadY   # "Nadia" — user's preferred voice

# ─── RAG tuning ────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-base
SEARCH_TOP_K=4
SEARCH_SCORE_THRESHOLD=0.7

# ─── CORS (comma-separated origins; use '*' only in dev) ───
CORS_ORIGINS=http://localhost:3000